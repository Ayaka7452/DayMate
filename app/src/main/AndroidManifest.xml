<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DayMateApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DayMate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.DayMate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EventFormActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".FolderActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".VaultFolderActivity"
            android:exported="false"
            android:parentActivityName=".VaultActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".RecycleBinActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <receiver
            android:name=".widget.CountdownWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 系统深浅色切换后立即重绘（此广播在豁免清单中，静态注册有效） -->
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <!-- 开机后续订跨天刷新闹钟（豁免清单内） -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 每天午夜跨天刷新（应用内自定闹钟广播） -->
                <action android:name="com.ayaka7452.daymate.widget.MIDNIGHT_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetSmallProvider"
            android:exported="false"
            android:label="@string/widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_small_info" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetSquareProvider"
            android:exported="false"
            android:label="@string/widget_label_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_square_info" />
        </receiver>

        <!-- 2×2「自动」模式多事件列表的数据源 -->
        <service
            android:name=".widget.CountdownWidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 小组件部署时的「选择显示事件」配置页 -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DayMate">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
