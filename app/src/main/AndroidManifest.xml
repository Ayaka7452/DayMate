<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 小组件跨天/开机刷新：接收 BOOT_COMPLETED 必须声明该权限，否则广播不会投递 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 检查更新：下载进度通知（Android 13+ 需运行时授权，未授权时前台服务仍可运行） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 下载安装包要走前台服务，Android 14 起必须同时声明类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 拉起系统安装器（Android 8+ 还需用户在系统设置里允许「安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--WebDAV 备份可配置为 http://（局域网/自建 NAS）：
        Android 9+ 默认拒绝明文流量，此处显式放开，否则 HTTP 服务器无法连接。-->
    <application
        android:name=".DayMateApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DayMate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.DayMate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EventDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".EventFormActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".FolderActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".CycleActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".VaultFolderActivity"
            android:exported="false"
            android:parentActivityName=".VaultActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".RecycleBinActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.DayMate" />

        <activity
            android:name=".WebDavActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.DayMate" />

        <receiver
            android:name=".widget.CountdownWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 深浅色切换不走这里：CONFIGURATION_CHANGED 只投递给运行时接收器，
                     由 DayMateApp.registerUiModeWatcher 动态注册并即时重绘 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 每天午夜跨天刷新（应用内自定闹钟广播） -->
                <action android:name="com.ayaka7452.daymate.widget.MIDNIGHT_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetSmallProvider"
            android:exported="false"
            android:label="@string/widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_small_info" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetSquareProvider"
            android:exported="false"
            android:label="@string/widget_label_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_square_info" />
        </receiver>

        <!-- 检查更新：前台服务下载 APK，通知栏显示进度 -->
        <service
            android:name=".core.update.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 把私有目录里的 APK 临时授权给系统安装器（Android 7+ 不允许再传 file:// URI） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 2×2「自动」模式多事件列表的数据源 -->
        <service
            android:name=".widget.CountdownWidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 小组件部署时的「选择显示事件」配置页 -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.DayMate">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
