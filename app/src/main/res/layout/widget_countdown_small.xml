<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件（迷你 2×1）：紧凑单行卡片
     字阶：标题 15sp / 日期 11sp / 数字 30sp + 单位 13sp（同行基线对齐） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- RemoteViews 布局白名单不含裸 <View>，卡片背景层必须用 FrameLayout -->
    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                android:textColor="#1C1B1F"
                android:text="DayMate" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#7A7570"
                android:text="暂无倒数日" />
        </LinearLayout>

        <!-- 数字与单位同行、基线对齐 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/widget_days_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="30sp"
                android:textColor="#1E78D0"
                android:text="" />

            <TextView
                android:id="@+id/widget_days_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textSize="13sp"
                android:textColor="#7A7570"
                android:text="" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
